FLASK_ENV=development
SECRET_KEY=replace-with-random-secret
DATABASE_URL=sqlite:///mrt_app.db
FRONTEND_ORIGIN=http://localhost:5173

DATA_PROVIDER=mock
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
LTA_ACCOUNT_KEY=

AI_PROVIDER=rule_based
AI_API_KEY=

UPLOAD_PROVIDER=local
UPLOAD_MAX_MB=5

RATE_LIMIT_INCIDENTS=10/hour
RATE_LIMIT_AI=30/hour

AI_DAILY_CALL_CAP=900
AI_CACHE_TTL_SECONDS=900

ALERTS_CACHE_TTL_SECONDS=60
